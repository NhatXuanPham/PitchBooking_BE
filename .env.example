BACKEND_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchbooking
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchbooking_test

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${FRONTEND_URL}/oauth/google/callback

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=PitchBooking

# OTP Configuration
OTP_SECRET_KEY=
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute;20/hour
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_VERIFY_OTP=10/minute
RATE_LIMIT_SEND_OTP=3/minute;10/hour
RATE_LIMIT_REFRESH=30/minute